# --- LLM (backend imports agent/src/graph.js directly, so this is needed here too) ---
GOOGLE_API_KEY=your-google-ai-studio-key-here

# --- Firebase Admin SDK (server-side) ---
# Local dev: path to the downloaded service account JSON (Firebase Console > Project Settings > Service Accounts)
# On Cloud Run in the same GCP project, leave this unset - applicationDefault() picks up the attached service account automatically
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=giftgraph-xxxxx

# --- Server config ---
PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- LLM (used indirectly via the agent package the backend imports) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Firebase Admin SDK (server-side) ---
# Path to the downloaded service account JSON (Firebase Console > Project Settings > Service Accounts)
# Never commit this file - it's covered by .gitignore
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=giftgraph-xxxxx

# --- Server config ---
PORT=8080
NODE_ENV=development

# Allowed origin for CORS - your frontend's Firebase Hosting URL (or http://localhost:5173 for local dev)
CORS_ORIGIN=http://localhost:5173

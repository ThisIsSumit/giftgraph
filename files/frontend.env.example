# Firebase client config (Firebase Console > Project Settings > General > Your apps > SDK config)
# All Vite env vars must be prefixed with VITE_ to be exposed to the browser
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=giftgraph-xxxxx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=giftgraph-xxxxx
VITE_FIREBASE_STORAGE_BUCKET=giftgraph-xxxxx.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Backend API base URL - Cloud Run URL in prod, localhost in dev
VITE_API_BASE_URL=http://localhost:8080


